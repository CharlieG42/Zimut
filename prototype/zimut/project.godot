; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Zimut"
config/version="0.0.01.94.0"
run/main_scene="res://scenes/Intro.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.05, 0.06, 0.1, 1)
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/icon_192.png"
script/strict_mode=false

[autoload]

GameManager="*res://scripts/GameManager.gd"
DataLoader="*res://scripts/DataLoader.gd"
Sfx="*res://scripts/Sfx.gd"
Music="*res://scripts/Music.gd"
ProgressionManager="*res://scripts/ProgressionManager.gd"
GameSettings="*res://scripts/GameSettings.gd"
Loc="*res://scripts/Loc.gd"
AssetCache="*res://scripts/AssetCache.gd"
PlayTimer="*res://scripts/PlayTimer.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/handheld/orientation="landscape"
window/fullscreen=true
window/borderless=false

[input]

move_left={
"deadzone": 0.5,
"events": []
}
move_right={
"deadzone": 0.5,
"events": []
}
move_up={
"deadzone": 0.5,
"events": []
}
move_down={
"deadzone": 0.5,
"events": []
}

[rendering]

2d/renderer/2d/texture_filter_mode="nearest"

textures/vram_compression/import_etc2_astc=true

[internationalization]

locale/fallback="fr"
